{
  "name": "@comput/pi-servicehost",
  "version": "0.5.0",
  "description": "Project-local service runtime, Pi tools and skill, and standalone terminal panel",
  "license": "MIT",
  "author": "Martin Bundgaard",
  "homepage": "https://github.com/mbundgaard/pi-servicehost#readme",
  "bugs": {
    "url": "https://github.com/mbundgaard/pi-servicehost/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbundgaard/pi-servicehost.git"
  },
  "keywords": [
    "pi-package",
    "service-runner",
    "cli",
    "linux",
    "process-management"
  ],
  "os": [
    "linux",
    "win32"
  ],
  "type": "module",
  "bin": {
    "pi-servicehost": "dist/cli.js"
  },
  "pi": {
    "extensions": [
      "./dist/extension.js"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "files": [
    "dist/extension.js",
    "dist/integration.js",
    "dist/herdr.js",
    "dist/herdr-app.js",
    "dist/config-store.js",
    "skills/servicehost/SKILL.md",
    "docs/pi-integration.md",
    "dist/cli.js",
    "dist/client.js",
    "dist/config.js",
    "dist/runtime.js",
    "dist/readiness.js",
    "dist/logs.js",
    "dist/watch.js",
    "dist/panel.js",
    "dist/platform.js",
    "dist/linux-group.js",
    "dist/linux-group-helper.js",
    "dist/windows-launch.js",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "ServiceHost.example.json",
    "docs/design.md",
    "docs/panel-design.md",
    "docs/validation.md",
    "docs/windows-lifecycle.md",
    "docs/release.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepack": "npm run build",
    "check:package": "npm run build && node --test tests/package.test.mjs && npm pack --dry-run --ignore-scripts"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@types/node": "^22.0.0",
    "typebox": "^1.3.7",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@earendil-works/pi-coding-agent@1.0.4": {
      "@earendil-works/pi-codemode": "1.0.4",
      "undici": "8.12.2"
    }
  }
}
